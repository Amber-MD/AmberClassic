#!/bin/sh

sander="../../../bin/msander"

if [ ! -z "$DO_PARALLEL" ]; then
   sander=$sander.MPI
   export OMP_NUM_THREADS=1
fi

output=1ahoa.pme.out

cat > mdin <<EOF
1ahoa crystal unit cell
 &cntrl
    ntx=1, ntpr=1, ntwx=0, ntwr=0
    ioutfm=1
    imin=0, drms=1E-4
    nstlim=0,
    ig=314159
    ntb=1
    irism=1
    cut=8.0
 /
 &rism
    periodic='pme'
    closure='kh'
    grdspc=1,1,1
    solvcut=12.d0
    verbose=1
    npropagate=5
    mdiis_del=0.7, mdiis_nvec=5, tolerance=1e-10
    apply_rism_force=0
 /
EOF

$DO_PARALLEL $sander -O -i mdin -o $output \
    -p 1ahoa.parm7 -c 1ahoa.rst7 \
    -xvv ../xvv/spc-nacl.kh.xvv \
    < /dev/null || { echo "  $0:  Program error"; exit 1; }

grep -E "^rism_|^solute" mdout | grep -v "rism_DCFintegral"  > erism.pme.out
../../dacdif -r 5.e-2 erism.pme.out.save erism.pme.out
/bin/rm -f mdin mdinfo restrt
exit 0

