#!/bin/sh

. ../program_error.sh

DACDIF=../dacdif

tleap=../../bin/tleap
leaprc=../../dat/leap/cmd/oldff/leaprc.ff10
ion_params=../../dat/leap/parm/frcmod.ionsjc_tip3p
dry_prefix1=sys1
dry_prefix2=sys2
d_prefix=d_glu

cat > leap.in << EOF
# Source the force field
source $leaprc
source leaprc.water.tip3p
loadamberparams $ion_params

# Change the default PB radii
set default pbradii mbondi2

# Create 2 sequences
sys = sequence {NALA ASP GLU LYS TYR HIP HIS HID MET THR TRP CYM NME}
sys2 = sequence {ACE PHE ALA LEU ILE GLY SER GLN ASN VAL PRO CCYS}

# Save a non-solvated PDB file (should have no CRYST1)
savePdb sys alphabet.pdb
savePdb sys2 alphabet2.pdb

# Save a non-solvated topology
saveamberparm sys $dry_prefix1.mbondi2.parm7 $dry_prefix1.mbondi2.rst7
saveamberparm sys2 $dry_prefix2.mbondi2.parm7 $dry_prefix2.mbondi2.rst7

# Change the default PB radii again
set default pbradii mbondi

# Translate the first system 10 units away, then combine the 2 sys's
translate sys {10 0 0}
total = combine {sys sys2}
saveamberparm total ${dry_prefix1}_${dry_prefix2}.mbondi.parm7 ${dry_prefix1}_${dry_prefix2}.mbondi.rst7

# Make a copy of GLU and reflect it in the xy-plane to create its stereoisomer,
# then create a capped version of that amino acid
dglu = copy GLU
transform dglu {{1 0 0} {0 1 0} {0 0 -1}}
d_amino = sequence {ACE dglu NME}

# Set a new radii set, then save the d_amino topology
set default pbradii bondi
saveamberparm d_amino $d_prefix.bondi.parm7 $d_prefix.bondi.rst7

# Solvate the system; trunc oct and cube
solvateOct sys TIP3PBOX 10.0
solvateBox sys2 TIP3PBOX 10.0

savePdb sys alphabet_wet.pdb
savePdb sys2 alphabet2_wet.pdb

# Test ChainID, Resid, hybrid36, overflow wrapping
sys3 = sequence {ACE PHE LEU CCYS}
set default keep_chainid on
set sys3.1 chainid AA
set sys3.1 resid 99999
set sys3.2 chainid AA
set sys3.2 resid 100000
set sys3.3 chainid BB
set sys3.3 resid 2436111
set sys3.4 chainid BB
set sys3.4 resid 2436112
set default hybrid36 off
savePdb sys3 overflow1.pdb
set default hybrid36 on
savePdb sys3 overflow2.pdb
saveAmberParm sys3 sys3chainid.parm7 sys3chainid.rst7

#test BIOMT symmetry expansion and large atomSerial + resId values
set default PdbReadBioMT 1
set default keep_chainid off
6o3h = loadPdb 6O3H.pdb
savePdb 6o3h 6O3H_hybrid36.pdb
set default hybrid36 off
savePdb 6o3h 6O3H_leap.pdb

quit
EOF

echo ""
echo "         Test of several LEaP features"
echo ""

$tleap -f leap.in > leap2.log

$DACDIF -a 3.e-6 $dry_prefix1.mbondi2.parm7.save $dry_prefix1.mbondi2.parm7
$DACDIF -a 3.e-6 $dry_prefix2.mbondi2.parm7.save $dry_prefix2.mbondi2.parm7
$DACDIF -a 6.e-5 $dry_prefix1.mbondi2.rst7.save $dry_prefix1.mbondi2.rst7
$DACDIF -a 3.e-6 ${dry_prefix1}_${dry_prefix2}.mbondi.parm7.save ${dry_prefix1}_${dry_prefix2}.mbondi.parm7
$DACDIF -a 7.e-5 ${dry_prefix1}_${dry_prefix2}.mbondi.rst7.save ${dry_prefix1}_${dry_prefix2}.mbondi.rst7
$DACDIF -a 3.e-6 $d_prefix.bondi.parm7.save $d_prefix.bondi.parm7
$DACDIF -a 3.e-5 $d_prefix.bondi.rst7.save $d_prefix.bondi.rst7
$DACDIF -a 2.e-3 alphabet.pdb.save alphabet.pdb
$DACDIF -a 2.e-3 alphabet2.pdb.save alphabet2.pdb
$DACDIF -a 2.e-3 alphabet_wet.pdb.save alphabet_wet.pdb
$DACDIF -a 2.e-3 alphabet2_wet.pdb.save alphabet2_wet.pdb
$DACDIF overflow1.pdb.save overflow1.pdb
$DACDIF overflow2.pdb.save overflow2.pdb
# only the last 100 lines are saved to avoid excess storage space
tail -100 6O3H_hybrid36.pdb >6O3H_hybrid36_last100.pdb
tail -100 6O3H_leap.pdb >6O3H_leap_last100.pdb
$DACDIF 6O3H_hybrid36_last100.pdb.save 6O3H_hybrid36_last100.pdb
$DACDIF 6O3H_leap_last100.pdb.save 6O3H_leap_last100.pdb
/bin/rm -f 6O3H_hybrid36.pdb 6O3H_leap.pdb

# /bin/rm -f leap.in leap.log leap2.log $dry_prefix2.mbondi2.rst7
