# ----- leaprc for loading the Glycam_06 carbohydrate force field
# also contains atom types for lipids
#
#       load atom type hybridizations
#	(includes atom types relevant to lipids)
#
addAtomTypes {
        { "C"   "C" "sp2" }
        { "Cg"  "C" "sp3" }
        { "Cy"  "C" "sp3" }
        { "Ck"  "C" "sp2" }
        { "CT"  "C" "sp3" }
        { "Cj"  "C" "sp2" }
        { "Cp"  "C" "sp3" } 
        { "H"   "H" "sp3" }
        { "H1"  "H" "sp3" }
        { "H2"  "H" "sp3" }
        { "Ha"  "H" "sp3" }
        { "Hp"  "H" "sp3" } 
        { "Hc"  "H" "sp3" }
        { "Ho"  "H" "sp3" }
        { "HW"  "H" "sp3" }
	{ "Ng"  "N" "sp2" }
        { "NT"  "N" "sp3" }
        { "N3"  "N" "sp3" } 
        { "Oh"  "O" "sp3" }
        { "Os"  "O" "sp3" }
        { "O"   "O" "sp2" }
        { "O2"  "O" "sp2" }
        { "OW"  "O" "sp3" }
        { "Oy"  "O" "sp3" }
        { "S"   "S" "sp3" }
        { "Sm"  "S" "sp3" }
        { "P"   "P" "sp3" } 
}
#
#       load the main paramter set
#
loadamberparams GLYCAM_06j.dat
##
#
#       load all GLYCAM PDB-standard versions and linking amino acid
#
loadOff GLYCAM_06j-1_PDB.lib

#
# for explicit solvent and ions
#
# the following assumes most users want to use tip3p as the 
# explicit solvent model 
# this can easily switched by the following commands in leap:
# WAT = TP5
# loadamberparams frcmod.tip5p
#
loadOff solvents.lib  # solvents 
HOH = TP3  # set default water model
WAT = TP3 
loadOff atomic_ions.lib  # load ions library
# to use ions for TIP5P, you will need to use a different frcmod below
# If desired, see the AMBER manual for additional ion force field options.
loadamberparams frcmod.ionsjc_tip3p  # set ion params for TIP3P

set H3O+.1 name H3O
set AG.1 restype ion
set AL.1 restype ion
set Ag.1 restype ion
set BA.1 restype ion
set BR.1 restype ion
set Be.1 restype ion
set CA.1 restype ion
set CD.1 restype ion
set CE.1 restype ion
set CL.1 restype ion
set CO.1 restype ion
set CR.1 restype ion
set CS.1 restype ion
set CU.1 restype ion
set CU1.1 restype ion
set Ce.1 restype ion
set Cl-.1 restype ion
set Cr.1 restype ion
set Dy.1 restype ion
set EU.1 restype ion
set EU3.1 restype ion
set Er.1 restype ion
set F.1 restype ion
set FE.1 restype ion
set FE2.1 restype ion
set GD3.1 restype ion
set H3O+.1 restype ion
set HE+.1 restype ion
set HG.1 restype ion
set HZ+.1 restype ion
set Hf.1 restype ion
set IN.1 restype ion
set IOD.1 restype ion
set K.1 restype ion
set K+.1 restype ion
set LA.1 restype ion
set LI.1 restype ion
set LU.1 restype ion
set MG.1 restype ion
set MN.1 restype ion
set NA.1 restype ion
set NH4.1 restype ion
set NI.1 restype ion
set Na+.1 restype ion
set Nd.1 restype ion
set PB.1 restype ion
set PD.1 restype ion
set PR.1 restype ion
set PT.1 restype ion
set Pu.1 restype ion
set RB.1 restype ion
set Ra.1 restype ion
set SM.1 restype ion
set SR.1 restype ion
set Sm.1 restype ion
set Sn.1 restype ion
set TB.1 restype ion
set TL.1 restype ion
